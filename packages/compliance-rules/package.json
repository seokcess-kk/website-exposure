    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@glitzy/shared-errors": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
