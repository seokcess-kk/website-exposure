{
  "name": "@glitzy/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./magic-link": { "types": "./dist/magic-link.d.ts", "import": "./dist/magic-link.js" },
    "./session": { "types": "./dist/session.d.ts", "import": "./dist/session.js" },
    "./resolve-tenant-context": { "types": "./dist/resolve-tenant-context.d.ts", "import": "./dist/resolve-tenant-context.js" },
    "./errors": { "types": "./dist/errors.d.ts", "import": "./dist/errors.js" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@glitzy/db": "workspace:*",
    "@glitzy/shared-errors": "workspace:*",
    "@glitzy/shared-types": "workspace:*",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
