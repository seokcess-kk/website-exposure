# Spike D 환경 변수 — postgres 4 DB (dev·staging·shadow·prod) on single instance

DATABASE_URL_DEV=postgres://postgres:postgres@localhost:5437/spike_d_dev
DATABASE_URL_STAGING=postgres://postgres:postgres@localhost:5437/spike_d_staging
DATABASE_URL_SHADOW=postgres://postgres:postgres@localhost:5437/spike_d_shadow
DATABASE_URL_PROD=postgres://postgres:postgres@localhost:5437/spike_d_prod

# Service-role guard (Spike A 패턴 재사용)
SERVICE_ROLE_ALLOWED_FUNCTIONS=migrationRunner,driftCheck,seedRunner

# Forward-only hotfix 승인 절차 (super-admin)
SUPER_ADMIN_CONFIRMATION_TOKEN=CONFIRM_FORWARD_ONLY_HOTFIX_2026Q2

# Advisory lock key (postgres bigint)
MIGRATION_ADVISORY_LOCK_KEY=8674665223082153551
