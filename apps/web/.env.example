# @glitzy/web — environment variables example (Plan v1.0 § 7)

# === DB connections (cycle9·10 정정 — WEB ≠ SEED 분리) ===
# WEB_DATABASE_URL: 웹 런타임 — 최소 권한 (BYPASSRLS/owner 금지)
#   필수 grant (자세한 사항은 Plan § 7):
#     GRANT SELECT ON instance TO <web_role>;
#     GRANT SELECT ON admin_user TO <web_role>;
#     GRANT SELECT ON instance_membership TO <web_role>;
#     GRANT INSERT ON audit_event TO <web_role>;
#     GRANT SELECT, INSERT, UPDATE, DELETE ON "session" TO <web_role>;
#     GRANT SELECT, INSERT, UPDATE ON "verificationToken" TO <web_role>;
#     GRANT app_tenant_user TO <web_role>;   -- NOINHERIT 권장
WEB_DATABASE_URL=postgres://web_role:password@localhost:5432/glitzy_dev

# WEB_PUBLIC_DATABASE_URL: 공개 사이트 SSR 전용 — app_public_reader (read-only · RLS instance_id scope)
#   필수 grant (PUBLIC_SITE_RENDER_PLAN v1.0 § 3.1 PSR-DATA-01 / D0011_public_reader.sql):
#     CREATE ROLE app_public_reader LOGIN PASSWORD 'app_public_reader_pw';
#     GRANT USAGE ON SCHEMA public TO app_public_reader;
#     GRANT SELECT ON instance, clinic_profile, location_profile,
#                     doctor_profile, treatment_page, article, legal_document TO app_public_reader;
#     + per-table CREATE POLICY public_reader_*_select (instance_id USING + status published)
WEB_PUBLIC_DATABASE_URL=postgres://app_public_reader:app_public_reader_pw@localhost:5432/glitzy_dev

# SEED_DATABASE_URL: seed CLI / migration — superuser/owner
SEED_DATABASE_URL=postgres://postgres:password@localhost:5432/glitzy_dev

# === Auth config (packages/auth.AuthConfig 정합) ===
# 로그인 = 계정 + 비밀번호 (scrypt · node:crypto). 이메일 인프라 불필요.
# 부트스트랩: seed 로 계정 생성 후
#   NEW_ADMIN_PASSWORD='...' pnpm --filter @glitzy/web set-password --email=<email>
AUTH_SECRET=replace-with-32-or-more-character-secret-here
SESSION_TTL_SECONDS=86400
SESSION_REFRESH_INTERVAL_SECONDS=3600

# === Next.js Server Actions body limit ===
NEXT_SERVER_ACTIONS_BODY_SIZE_LIMIT=2mb

NODE_ENV=development

# === Google Search Console (SEARCH_VISIBILITY_INGEST_PLAN v0.3 § 3) ===
# 둘 다 set 또는 둘 다 unset (pair 강제) — 한쪽만 채우면 boot 실패.
# unset 이면 /visibility-metrics 페이지 안 "GSC 미설정" 안내 카드 노출 + sync 액션 차단.
#
# 발급 절차 (runbook 참조):
#   1. GCP Console > IAM > Service Accounts > "Create service account"
#   2. Search Console > Settings > Users and permissions > <SA email> 을 Restricted user 로 추가
#      (Owner 권한 불요 — 데이터 조회만 필요)
#   3. SA key (JSON) 생성 → client_email + private_key 추출
#   4. private_key 는 PEM (BEGIN/END PRIVATE KEY) — 줄바꿈 \n 그대로 두거나 multiline 사용
#
# SECURITY:
#   - private_key 는 모든 로그·diff·UI 에서 절대 노출 금지
#   - 1Password/Vercel env (Encrypted) 외부에 평문 저장 금지
GOOGLE_SEARCH_CONSOLE_SA_EMAIL=
GOOGLE_SEARCH_CONSOLE_SA_PRIVATE_KEY=

# === 공개 사이트 도메인 (PSR-DEFER-02 + SUBDOMAIN_SCALE_PLAN) ===
# PUBLIC_SITE_ORIGIN: path-based canonical origin — 커스텀/파생 도메인이 없는 slug 는 <origin>/<slug> 로 서빙
PUBLIC_SITE_ORIGIN=

# CUSTOM_DOMAIN_MAP: host → instance slug 명시 매핑 (JSON · 항목 수 제한 없음 · 파생보다 항상 우선)
#   - 임의 고객 도메인용(라벨≠slug일 때만 필요) — daeatdiet-incheon 은 <slug>.onwell.site 파생으로 자동이라 불필요
#   - 키 = 정규화 host (lowercase · 포트/선행 www 없음), 값 = instance slug
#   - 한 slug 에 여러 host 매핑 시 첫 host 가 canonical — 나머지(alias·apex)는 production 에서 canonical 로 301
#   - module-load 1회 파싱 → 변경 후 redeploy 필수
#   예: {"clinic.example.com":"my-clinic"}
CUSTOM_DOMAIN_MAP=

# BASE_SITE_DOMAIN: 라벨=slug 와일드카드 파생 (SDS-01) — <slug>.<BASE> 를 해당 인스턴스로 자동 매핑
#   프로덕션 값: onwell.site (2026-07-03 구매 · SUBDOMAIN_SCALE_PLAN G0-5) — 예: songdo.onwell.site
#   ⚠️ Vercel "Production" 환경 전용으로만 설정 (코드 가드: NODE_ENV!==development && VERCEL_ENV===production)
#   ⚠️ Vercel 에 *.<BASE> 와일드카드 도메인(NS 위임 필수) TLS 가 라이브된 이후에만 설정할 것 —
#      역순이면 전 인스턴스 canonical 이 죽은 host 로 flip
#   `vercel env pull` 후 로컬 .env 에 내려오면 제거 권장 (코드 가드가 2중 방어)
BASE_SITE_DOMAIN=

# BASE_DOMAIN_EXCLUDE_SLUGS: 파생 제외 slug CSV — 미설정 시 기본 "demo" (내부/세일즈 인스턴스 노출 방지)
#   ⚠️ 값을 설정하면 기본값을 "대체" (합집합 아님) — demo 를 유지하려면 CSV 에 포함할 것 (예: demo,songdo)
#   빈 문자열을 명시하면 제외 없음
BASE_DOMAIN_EXCLUDE_SLUGS=demo

# === 사이트 트래킹 / IndexNow (MEANINGFUL_TRAFFIC_LOOP · 네이버 노출) ===
# TRACK_ORIGIN_ALLOWLIST: /api/track Origin 허용 목록 (CSV · "*.suffix" 와일드카드 지원)
#   프로덕션 예: *.onwell.site — 와일드카드 1회 등록으로 신규 서브도메인 자동 커버
TRACK_ORIGIN_ALLOWLIST=

# NAVER_INDEXNOW_KEY: IndexNow 발행 키 (public/<key>.txt 파일과 쌍) — 미설정 시 발행이 조용히 비활성
NAVER_INDEXNOW_KEY=
