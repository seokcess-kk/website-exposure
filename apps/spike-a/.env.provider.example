# Spike A — PROVIDER_PASS (Supabase Pooler·Day 9)
# Supabase Dashboard → Project Settings → Database
# - Transaction pooling URL (port 6543) — application 사용·SET LOCAL OK·prepared statements 비활성
# - Session pooling URL (port 5432) — migration·service_role 사용

# === Super (postgres) — migration·service_role·audit_log control plane ===
# Session mode 사용 (migration·DDL·long-running)
# Format: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_SUPER=postgres://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# === Tenant (app_tenant_user) — RLS·application path ===
# Transaction mode 사용 (port 6543·withTenantTransaction에 적합·prepare:false 필수)
# CAVEAT: Supabase Pooler transaction mode는 prepared statements 미지원 → postgres-js prepare:false 강제
DATABASE_URL_TENANT=postgres://app_tenant_user.YOUR_PROJECT_REF:YOUR_TENANT_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# === pgBouncer mode 명시 (postgres-js 기본 동작 영향) ===
# Supabase Pooler는 pgBouncer 내장·application은 prepare:false·max=10 권장
DB_PREPARE=false
DB_MAX_CONNECTIONS=5

# === Test config ===
INVARIANT_ITER=100
INVARIANT_CONCURRENT=10
