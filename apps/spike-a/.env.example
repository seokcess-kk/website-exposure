# Spike A 환경 변수 예시 (실제 .env로 복사 후 사용)

# Direct connection (postgres user — RLS bypass용·migration 실행)
DATABASE_URL_SUPER=postgres://postgres:postgres@localhost:5435/spike_a

# Tenant connection via pgbouncer (transaction pooling) — RLS 적용
DATABASE_URL_TENANT=postgres://app_tenant_user:app_tenant_pw@localhost:6435/spike_a

# Service role connection (postgres user — break-glass)
DATABASE_URL_SERVICE_ROLE=postgres://postgres:postgres@localhost:5435/spike_a

# Invariant runner config
INVARIANT_ITER=1000
INVARIANT_CONCURRENCY=20
