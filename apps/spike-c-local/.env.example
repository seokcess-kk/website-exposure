# Spike C local 환경 변수 (LOCAL ONLY — minio)

# S3 (minio) endpoint
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=spike-c

# Root admin (bucket·prefix 관리·테스트 setup 전용 — limited principal 흉내 불가, scenario에서는 보조 사용)
S3_ROOT_ACCESS_KEY=minioadmin
S3_ROOT_SECRET_KEY=minioadmin

# Instance-principal credentials (minio per-instance user — mc admin user add로 mc-init이 생성)
# Spike C-local에서 application-layer가 아닌 credential-level isolation 부분 검증용
# 단, R2 IAM Condition 동등하지는 않음 — C-provider gate에서 권위 검증
S3_INSTANCE_A_ACCESS_KEY=instance-a-key
S3_INSTANCE_A_SECRET_KEY=instance-a-secret-12345
S3_INSTANCE_B_ACCESS_KEY=instance-b-key
S3_INSTANCE_B_SECRET_KEY=instance-b-secret-12345

# Signed URL config (SoT: INFRA_DECISIONS_DRAFT v1.0 § Storage)
SIGNED_URL_TTL_SECONDS=600
SIGNED_URL_REFRESH_BEFORE_SECONDS=60
SIGNED_URL_MAX_TTL_SECONDS=86400

# Invariant runner config
INVARIANT_INSTANCES=5
INVARIANT_OBJECTS_PER_INSTANCE=100
INVARIANT_CROSS_ATTEMPTS=200
