# Spike C — PROVIDER_PASS environment (Cloudflare R2 staging)
# 본 파일은 .env로 복사·실제 값 채워서 사용
# 보안: 절대 git commit·secret store (Vercel·1Password 등) 사용 권장

# === Cloudflare R2 ===
# Account ID: Cloudflare Dashboard → Workers & Pages 우측 sidebar
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Bucket — Day 8 staging용 (별도 ephemeral·LOCAL과 격리)
S3_REGION=auto
S3_BUCKET=spike-c-staging

# Root token — bucket 관리·seed (R2 API token: Object Read/Write·all buckets)
S3_ROOT_ACCESS_KEY=YOUR_ROOT_ACCESS_KEY
S3_ROOT_SECRET_KEY=YOUR_ROOT_SECRET_KEY

# Instance principal tokens (R2 API token: Object Read/Write·specific bucket·prefix scope 권장)
# R2 PolicyDocument로 prefix `instances/{instanceId}/` 조건부 부여
# CAVEAT: R2는 AWS S3와 동일 IAM PolicyDocument를 100% 지원하지 않음 — Workers binding 또는 prefix scope만 가능
S3_INSTANCE_A_ACCESS_KEY=YOUR_INSTANCE_A_ACCESS_KEY
S3_INSTANCE_A_SECRET_KEY=YOUR_INSTANCE_A_SECRET_KEY
S3_INSTANCE_B_ACCESS_KEY=YOUR_INSTANCE_B_ACCESS_KEY
S3_INSTANCE_B_SECRET_KEY=YOUR_INSTANCE_B_SECRET_KEY

# Signed URL config (LOCAL과 동일)
SIGNED_URL_TTL_SECONDS=600
SIGNED_URL_REFRESH_BEFORE_SECONDS=60
SIGNED_URL_MAX_TTL_SECONDS=86400

# Invariant
INVARIANT_INSTANCES=3
INVARIANT_OBJECTS_PER_INSTANCE=20
INVARIANT_CROSS_ATTEMPTS=50

# Provider-specific: R2는 path-style endpoint·forcePathStyle=true 그대로 호환
FORCE_PATH_STYLE=true
