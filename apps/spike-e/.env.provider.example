# Spike E — PROVIDER_PASS (Vercel preview + Auth.js + Supabase + Resend·Day 10)

# === Supabase (Spike A·B project 재활용 가능) ===
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# === Next.js + Auth.js (next-auth v5) ===
NEXTAUTH_URL=https://YOUR_PREVIEW.vercel.app
NEXTAUTH_SECRET=GENERATE_VIA_openssl_rand_base64_32

# Auth.js Email (magic link) provider
EMAIL_FROM=noreply@YOUR_DOMAIN

# === Resend (magic link email 발송) ===
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_DOMAIN=YOUR_DOMAIN (DNS verified)

# === Spike E config (LOCAL과 동일) ===
MAGIC_LINK_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400
SESSION_REFRESH_INTERVAL_SECONDS=300
AUTH_SECRET=GENERATE_VIA_openssl_rand_base64_32_DIFFERENT_FROM_NEXTAUTH_SECRET

# === Vercel preview smoke target ===
PREVIEW_BASE_URL=https://YOUR_PREVIEW.vercel.app
TEST_EMAIL_ADDRESS=YOUR_TEST_EMAIL@example.com
