# Spike E 환경 변수

DATABASE_URL=postgres://postgres:postgres@localhost:5438/spike_e

# Magic link / session config
MAGIC_LINK_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400
SESSION_REFRESH_INTERVAL_SECONDS=300

# Auth.js style secret (HMAC signing)
AUTH_SECRET=local-dev-secret-do-not-use-in-production-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Resend mock — token을 in-memory queue로
RESEND_MODE=mock
