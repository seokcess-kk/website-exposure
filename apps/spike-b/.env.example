# Spike B 환경 변수 예시 (LOCAL ONLY)

# Super (postgres user — control-plane access·migration·service-role)
DATABASE_URL_SUPER=postgres://postgres:postgres@localhost:5436/spike_b

# Tenant (app_tenant_user — RLS 적용. inbox·tenant table 접근)
DATABASE_URL_TENANT=postgres://app_tenant_user:app_tenant_pw@localhost:5436/spike_b

# Invariant runner config
INVARIANT_JOBS=1000
INVARIANT_WORKERS=10
INVARIANT_RUNS=5

# Basic scenario config
BASIC_JOBS=100
BASIC_WORKERS=5
